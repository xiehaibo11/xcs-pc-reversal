<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="distinguish.OnlineWindows" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:distinguish" Window.WindowStartupLocation="CenterScreen" Window.Title="联机配置" FrameworkElement.Height="340" FrameworkElement.Width="450" Window.ResizeMode="NoResize">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:RadioToBoolConverter x:Key="genderConverterKey" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <StackPanel FrameworkElement.Margin="4,4,4,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">东方：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding Path="ConfigNumber.East"/>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">南方：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding Path="ConfigNumber.South"/>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">西方：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding Path="ConfigNumber.West"/>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">北方：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding Path="ConfigNumber.North"/>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="4">
          <Button FrameworkElement.Margin="10,0,0,0" Click="SaveConfigNumber_Click">
            <ContentControl.Content>
              <Binding Path="SaveConfigNumberButContent"/>
            </ContentControl.Content>
            <UIElement.IsEnabled>
              <Binding Path="SaveConfigNumberButIsDisable"/>
            </UIElement.IsEnabled>
            <!--Unknown connection ID: 1-->
          </Button>
        </Grid>
      </Grid>
      <Border FrameworkElement.Margin="0,10,0,0" FrameworkElement.Height="0.5" Background="#FF000000" />
      <Grid FrameworkElement.Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0">数据发送：</Label>
        <StackPanel Grid.Column="1" Orientation="Horizontal" FrameworkElement.Margin="0,6,0,0">
          <RadioButton>
            <ToggleButton.IsChecked>
              <Binding Path="DataConfig.Data_send" Converter="{StaticResource genderConverterKey}" ConverterParameter="1"/>
            </ToggleButton.IsChecked>自动发送</RadioButton>
          <RadioButton FrameworkElement.Margin="4,0,0,0">
            <ToggleButton.IsChecked>
              <Binding Path="DataConfig.Data_send" Converter="{StaticResource genderConverterKey}" ConverterParameter="0"/>
            </ToggleButton.IsChecked>手动发送</RadioButton>
        </StackPanel>
      </Grid>
      <Grid FrameworkElement.Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0">计数方式：</Label>
        <StackPanel Grid.Column="1" Orientation="Horizontal" FrameworkElement.Margin="0,6,0,0">
          <RadioButton>
            <ToggleButton.IsChecked>
              <Binding Path="DataConfig.Count_type" Converter="{StaticResource genderConverterKey}" ConverterParameter="1"/>
            </ToggleButton.IsChecked>光控计数</RadioButton>
          <RadioButton FrameworkElement.Margin="4,0,0,0">
            <ToggleButton.IsChecked>
              <Binding Path="DataConfig.Count_type" Converter="{StaticResource genderConverterKey}" ConverterParameter="0"/>
            </ToggleButton.IsChecked>机头计数</RadioButton>
        </StackPanel>
      </Grid>
      <Grid FrameworkElement.Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">超时发送时间：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding Path="DataConfig.Timeout"/>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">延时发送时间：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding Path="DataConfig.Delay"/>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="2">
          <Button FrameworkElement.Margin="10,0,0,0" Click="SaveDataConfig_Click">
            <ContentControl.Content>
              <Binding Path="SaveDataConfigButContent"/>
            </ContentControl.Content>
            <UIElement.IsEnabled>
              <Binding Path="SaveDataConfigButIsDisable"/>
            </UIElement.IsEnabled>
            <!--Unknown connection ID: 2-->
          </Button>
        </Grid>
      </Grid>
      <Border FrameworkElement.Margin="0,10,0,0" FrameworkElement.Height="0.5" Background="#FF000000" />
      <StackPanel Orientation="Horizontal" FrameworkElement.Margin="0,10,0,0">
        <Label ContentControl.Content="当前WIFI配置：" />
        <Label ContentControl.Content="《" />
        <Label>
          <ContentControl.Content>
            <Binding Path="WifiConfig.Ssid"/>
          </ContentControl.Content>
        </Label>
        <Label ContentControl.Content="》" />
        <Label ContentControl.Content="密码：" />
        <Label ContentControl.Content="《" />
        <Label>
          <ContentControl.Content>
            <Binding Path="WifiConfig.Pwd"/>
          </ContentControl.Content>
        </Label>
        <Label ContentControl.Content="》" />
      </StackPanel>
      <Grid FrameworkElement.Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">WIFI：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding Path="WifiConfig.Ssid"/>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">密码：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding Path="WifiConfig.Pwd"/>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="2">
          <Button FrameworkElement.Margin="10,0,0,0" Click="SaveWifi_Click">
            <ContentControl.Content>
              <Binding Path="SaveWifiConfigButContent"/>
            </ContentControl.Content>
            <UIElement.IsEnabled>
              <Binding Path="SaveWifiConfigButIsDisable"/>
            </UIElement.IsEnabled>
            <!--Unknown connection ID: 3-->
          </Button>
        </Grid>
      </Grid>
      <Border FrameworkElement.Margin="0,10,0,0" FrameworkElement.Height="0.5" Background="#FF000000" />
      <WrapPanel FrameworkElement.Margin="0,20,0,0">
        <Button Control.Padding="10,10,10,10" Click="RestartDevice_Click">重启所有设备<!--Unknown connection ID: 4--></Button>
        <Button FrameworkElement.Margin="15,0,0,0" Control.Padding="10,10,10,10" Click="ResetVerifyPwd_Click">重置专属密码<!--Unknown connection ID: 5--></Button>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>