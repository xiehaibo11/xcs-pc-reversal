<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="distinguish.EditPwdWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:distinguish" Control.FontSize="13" Window.WindowStartupLocation="CenterScreen" Window.ResizeMode="NoResize" Window.Title="修改密码" FrameworkElement.Height="300" FrameworkElement.Width="450">
  <Grid>
    <StackPanel FrameworkElement.Width="320" FrameworkElement.Margin="0,20,0,20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="80" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" ContentControl.Content="旧密码：" FrameworkElement.VerticalAlignment="Center" />
        <TextBox FrameworkElement.Name="ipAddrInput" Grid.Column="1" FrameworkElement.Margin="10" Control.Padding="2,0,2,0" Control.VerticalContentAlignment="Center" FrameworkElement.Height="30">
          <TextBox.Text>
            <Binding Path="OldPwd"/>
          </TextBox.Text>
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <VisualBrush x:Key="HelpBrush" TileBrush.TileMode="None" Brush.Opacity="0.3" TileBrush.Stretch="None" TileBrush.AlignmentX="Left">
                <VisualBrush.Visual>
                  <TextBlock FontStyle="Italic" Text="请输入旧密码" />
                </VisualBrush.Visual>
              </VisualBrush>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <FrameworkElement.Style>
            <Style>
              
              <Style.Triggers>
                <Trigger Property="TextBox.Text">
                  <Trigger.Value>
                    <x:NullExtension />
                  </Trigger.Value>
                  <Setter Property="Control.Background" Value="{StaticResource HelpBrush}" />
                </Trigger>
                <Trigger Property="TextBox.Text" Value="">
                  <Setter Property="Control.Background" Value="{StaticResource HelpBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <!--Unknown connection ID: 1-->
        </TextBox>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="80" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" ContentControl.Content="新密码：" FrameworkElement.VerticalAlignment="Center" />
        <TextBox FrameworkElement.Name="userInput" Grid.Column="1" FrameworkElement.Margin="10" Control.Padding="2,0,2,0" Control.VerticalContentAlignment="Center" FrameworkElement.Height="30">
          <TextBox.Text>
            <Binding Path="NewPwd"/>
          </TextBox.Text>
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <VisualBrush x:Key="HelpBrush" TileBrush.TileMode="None" Brush.Opacity="0.3" TileBrush.Stretch="None" TileBrush.AlignmentX="Left">
                <VisualBrush.Visual>
                  <TextBlock FontStyle="Italic" Text="请输入新密码" />
                </VisualBrush.Visual>
              </VisualBrush>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <FrameworkElement.Style>
            <Style>
              
              <Style.Triggers>
                <Trigger Property="TextBox.Text">
                  <Trigger.Value>
                    <x:NullExtension />
                  </Trigger.Value>
                  <Setter Property="Control.Background" Value="{StaticResource HelpBrush}" />
                </Trigger>
                <Trigger Property="TextBox.Text" Value="">
                  <Setter Property="Control.Background" Value="{StaticResource HelpBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <!--Unknown connection ID: 2-->
        </TextBox>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="80" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" ContentControl.Content="重复新密码：" FrameworkElement.VerticalAlignment="Center" />
        <TextBox FrameworkElement.Name="pwdInput" Grid.Column="1" FrameworkElement.Margin="10" Control.Padding="2,0,2,0" Control.VerticalContentAlignment="Center" FrameworkElement.Height="30">
          <TextBox.Text>
            <Binding Path="ReNewPwd"/>
          </TextBox.Text>
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <VisualBrush x:Key="HelpBrush" TileBrush.TileMode="None" Brush.Opacity="0.3" TileBrush.Stretch="None" TileBrush.AlignmentX="Left">
                <VisualBrush.Visual>
                  <TextBlock FontStyle="Italic" Text="请输入重复新密码" />
                </VisualBrush.Visual>
              </VisualBrush>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <FrameworkElement.Style>
            <Style>
              
              <Style.Triggers>
                <Trigger Property="TextBox.Text">
                  <Trigger.Value>
                    <x:NullExtension />
                  </Trigger.Value>
                  <Setter Property="Control.Background" Value="{StaticResource HelpBrush}" />
                </Trigger>
                <Trigger Property="TextBox.Text" Value="">
                  <Setter Property="Control.Background" Value="{StaticResource HelpBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <!--Unknown connection ID: 3-->
        </TextBox>
      </Grid>
      <Button FrameworkElement.Name="loginBut" Grid.Row="4" FrameworkElement.Margin="10,24,10,0" FrameworkElement.Height="44" Control.FontSize="16" Control.FontWeight="Bold" FrameworkElement.Cursor="Hand">
        <ContentControl.Content>
          <Binding Path="LoginButContent"/>
        </ContentControl.Content>
        <UIElement.IsEnabled>
          <Binding Path="LoginButIsDisable"/>
        </UIElement.IsEnabled>
        <!--Unknown connection ID: 4-->
      </Button>
    </StackPanel>
  </Grid>
</Window>