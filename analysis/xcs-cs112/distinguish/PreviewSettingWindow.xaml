<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="distinguish.PreviewSettingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:distinguish" Window.WindowStartupLocation="CenterScreen" Window.ResizeMode="NoResize" Window.Title="窗口预览" FrameworkElement.Height="340" FrameworkElement.Width="640">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid Column="0" FrameworkElement.Width="320" FrameworkElement.Height="240">
      <Image FrameworkElement.Width="320" FrameworkElement.Height="240" Stretch="None">
        <Image.Source>
          <Binding Path="ImgPath"/>
        </Image.Source>
      </Image>
    </Grid>
    <Grid Column="0" FrameworkElement.Width="320" FrameworkElement.Height="240">
      <Canvas FrameworkElement.Width="320" FrameworkElement.Height="240" UIElement.Opacity="0.5">
        <Grid Panel.Background="#FFFF0000">
          <FrameworkElement.Width>
            <Binding Path="Width"/>
          </FrameworkElement.Width>
          <FrameworkElement.Height>
            <Binding Path="Height"/>
          </FrameworkElement.Height>
          <Canvas.Top>
            <Binding Path="Y"/>
          </Canvas.Top>
          <Canvas.Left>
            <Binding Path="X"/>
          </Canvas.Left>
        </Grid>
      </Canvas>
    </Grid>
    <Grid Column="0" FrameworkElement.Width="320" FrameworkElement.Height="240">
      <UIElement.Visibility>
        <Binding Path="DataStatus"/>
      </UIElement.Visibility>
      <Label Control.Foreground="#FFFF0000" Control.FontWeight="Bold">预览画面未上传</Label>
    </Grid>
    <Grid Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition />
        <RowDefinition Height="60" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <Label>
          <ContentControl.Content>
            <Binding Path="PreviewName"/>
          </ContentControl.Content>
        </Label>
        <Label Control.FontSize="12" Control.Foreground="#FFFF0000" Control.FontWeight="Bold">
          <UIElement.Visibility>
            <Binding Path="DataStatus"/>
          </UIElement.Visibility>预览画面未上传</Label>
      </StackPanel>
      <TabControl Grid.Row="1" FrameworkElement.Margin="0,0,10,0">
        <TabItem HeaderedContentControl.Header="图形画框">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">上边</Label>
                <Button FrameworkElement.Width="20" Grid.Column="1" Click="YSub">-<!--Unknown connection ID: 1--></Button>
                <Slider RangeBase.Minimum="0" RangeBase.Maximum="240" FrameworkElement.Margin="4,0,0,4" Grid.Column="2">
                  <RangeBase.Value>
                    <Binding Path="Y"/>
                  </RangeBase.Value>
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="3" Click="YAdd">+<!--Unknown connection ID: 2--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">左边</Label>
                <Button FrameworkElement.Width="20" Grid.Column="1" Click="XSub">-<!--Unknown connection ID: 3--></Button>
                <Slider RangeBase.Minimum="0" RangeBase.Maximum="300" FrameworkElement.Margin="4,0,0,4" Grid.Column="2">
                  <RangeBase.Value>
                    <Binding Path="X"/>
                  </RangeBase.Value>
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="3" Click="XAdd">+<!--Unknown connection ID: 4--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">宽度</Label>
                <Button FrameworkElement.Width="20" Grid.Column="1" Click="WidthSub">-<!--Unknown connection ID: 5--></Button>
                <Slider RangeBase.Minimum="1" RangeBase.Maximum="320" FrameworkElement.Margin="4,0,0,4" Grid.Column="2">
                  <RangeBase.Value>
                    <Binding Path="Width"/>
                  </RangeBase.Value>
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="3" Click="WidthAdd">+<!--Unknown connection ID: 6--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">高度</Label>
                <Button FrameworkElement.Width="20" Grid.Column="1" Click="HeightSub">-<!--Unknown connection ID: 7--></Button>
                <Slider RangeBase.Minimum="1" RangeBase.Maximum="50" FrameworkElement.Margin="4,0,0,4" Grid.Column="2">
                  <RangeBase.Value>
                    <Binding Path="Height"/>
                  </RangeBase.Value>
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="3" Click="HeightAdd">+<!--Unknown connection ID: 8--></Button>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem HeaderedContentControl.Header="图像质量">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel FrameworkElement.Margin="0,0,6,0">
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">图像旋转:</Label>
                <Label Grid.Column="1">
                  <ContentControl.Content>
                    <Binding Path="ImgRotation"/>
                  </ContentControl.Content>
                </Label>
                <Button FrameworkElement.Width="20" Grid.Column="2" Click="ImgRotationSub">-<!--Unknown connection ID: 9--></Button>
                <Slider RangeBase.Maximum="64" Grid.Column="3" RangeBase.Minimum="-64" FrameworkElement.Margin="4,0,0,4" ValueChanged="Slider_ValueChanged">
                  <RangeBase.Value>
                    <Binding Path="ImgRotation"/>
                  </RangeBase.Value>
                  <!--Unknown connection ID: 10-->
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="4" Click="ImgRotationAdd">+<!--Unknown connection ID: 11--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">灯光亮度:</Label>
                <Label Grid.Column="1">
                  <ContentControl.Content>
                    <Binding Path="CapBrightness"/>
                  </ContentControl.Content>
                </Label>
                <Button FrameworkElement.Width="20" Grid.Column="2" Click="BrightnessSub">-<!--Unknown connection ID: 12--></Button>
                <Slider RangeBase.Maximum="64" Grid.Column="3" RangeBase.Minimum="-64" FrameworkElement.Margin="4,0,0,4" ValueChanged="Slider_ValueChanged">
                  <RangeBase.Value>
                    <Binding Path="CapBrightness"/>
                  </RangeBase.Value>
                  <!--Unknown connection ID: 13-->
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="4" Click="BrightnessAdd">+<!--Unknown connection ID: 14--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">增益:</Label>
                <Label Grid.Column="1">
                  <ContentControl.Content>
                    <Binding Path="CapGain"/>
                  </ContentControl.Content>
                </Label>
                <Button FrameworkElement.Width="20" Grid.Column="2" Click="CapGainSub">-<!--Unknown connection ID: 15--></Button>
                <Slider RangeBase.Maximum="64" Grid.Column="3" RangeBase.Minimum="-64" FrameworkElement.Margin="4,0,0,4" ValueChanged="Slider_ValueChanged">
                  <RangeBase.Value>
                    <Binding Path="CapGain"/>
                  </RangeBase.Value>
                  <!--Unknown connection ID: 16-->
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="4" Click="CapGainAdd">+<!--Unknown connection ID: 17--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">曝光值:</Label>
                <Label Grid.Column="1">
                  <ContentControl.Content>
                    <Binding Path="CapExposure"/>
                  </ContentControl.Content>
                </Label>
                <Button FrameworkElement.Width="20" Grid.Column="2" Click="CapExposureSub">-<!--Unknown connection ID: 18--></Button>
                <Slider RangeBase.Maximum="500" Grid.Column="3" RangeBase.Minimum="-500" FrameworkElement.Margin="4,0,0,4" ValueChanged="Slider_ValueChanged">
                  <RangeBase.Value>
                    <Binding Path="CapExposure"/>
                  </RangeBase.Value>
                  <!--Unknown connection ID: 19-->
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="4" Click="CapExposureAdd">+<!--Unknown connection ID: 20--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">色调:</Label>
                <Label Grid.Column="1">
                  <ContentControl.Content>
                    <Binding Path="CapHue"/>
                  </ContentControl.Content>
                </Label>
                <Button FrameworkElement.Width="20" Grid.Column="2" Click="CapHueSub">-<!--Unknown connection ID: 21--></Button>
                <Slider RangeBase.Maximum="500" Grid.Column="3" RangeBase.Minimum="-500" FrameworkElement.Margin="4,0,0,4" ValueChanged="Slider_ValueChanged">
                  <RangeBase.Value>
                    <Binding Path="CapHue"/>
                  </RangeBase.Value>
                  <!--Unknown connection ID: 22-->
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="4" Click="CapHueAdd">+<!--Unknown connection ID: 23--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">饱和度:</Label>
                <Label Grid.Column="1">
                  <ContentControl.Content>
                    <Binding Path="CapSaturation"/>
                  </ContentControl.Content>
                </Label>
                <Button FrameworkElement.Width="20" Grid.Column="2" Click="CapSaturationSub">-<!--Unknown connection ID: 24--></Button>
                <Slider RangeBase.Maximum="500" Grid.Column="3" RangeBase.Minimum="-500" FrameworkElement.Margin="4,0,0,4" ValueChanged="Slider_ValueChanged">
                  <RangeBase.Value>
                    <Binding Path="CapSaturation"/>
                  </RangeBase.Value>
                  <!--Unknown connection ID: 25-->
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="4" Click="CapSaturationAdd">+<!--Unknown connection ID: 26--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">对比度:</Label>
                <Label Grid.Column="1">
                  <ContentControl.Content>
                    <Binding Path="CapContrast"/>
                  </ContentControl.Content>
                </Label>
                <Button FrameworkElement.Width="20" Grid.Column="2" Click="CapContrastSub">-<!--Unknown connection ID: 27--></Button>
                <Slider RangeBase.Maximum="500" Grid.Column="3" RangeBase.Minimum="-500" FrameworkElement.Margin="4,0,0,4" ValueChanged="Slider_ValueChanged">
                  <RangeBase.Value>
                    <Binding Path="CapContrast"/>
                  </RangeBase.Value>
                  <!--Unknown connection ID: 28-->
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="4" Click="CapContrastAdd">+<!--Unknown connection ID: 29--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">二值数:</Label>
                <Label Grid.Column="1">
                  <ContentControl.Content>
                    <Binding Path="ImgMinHreshold"/>
                  </ContentControl.Content>
                </Label>
                <Button FrameworkElement.Width="20" Grid.Column="2" Click="ImgMinHresholdSub">-<!--Unknown connection ID: 30--></Button>
                <Slider RangeBase.Maximum="255" Grid.Column="3" RangeBase.Minimum="0" FrameworkElement.Margin="4,0,0,4" ValueChanged="Slider_ValueChanged">
                  <RangeBase.Value>
                    <Binding Path="ImgMinHreshold"/>
                  </RangeBase.Value>
                  <!--Unknown connection ID: 31-->
                </Slider>
                <Button FrameworkElement.Width="20" Grid.Column="4" Click="ImgMinHresholdAdd">+<!--Unknown connection ID: 32--></Button>
              </Grid>
              <Grid FrameworkElement.Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition Width="auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0">镜头帧率:</Label>
                <Label Grid.Column="1">
                  <ContentControl.Content>
                    <Binding Path="CapFps"/>
                  </ContentControl.Content>
                </Label>
                <ComboBox Name="___CapFpsComboBox" Grid.Column="2" FrameworkElement.HorizontalAlignment="Left" FrameworkElement.Margin="0,0,0,0" FrameworkElement.VerticalAlignment="Top" FrameworkElement.Width="100" SelectionChanged="ComboBox_SelectionChanged">
                  <ComboBoxItem>60FPS</ComboBoxItem>
                  <ComboBoxItem>70FPS</ComboBoxItem>
                  <ComboBoxItem>80FPS</ComboBoxItem>
                  <ComboBoxItem>90FPS</ComboBoxItem>
                  <ComboBoxItem>180FPS</ComboBoxItem>
                  <!--Unknown connection ID: 33-->
                </ComboBox>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem HeaderedContentControl.Header="电机配置">
          <StackPanel>
            <Grid FrameworkElement.Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
              </Grid.ColumnDefinitions>
              <Label Grid.Column="0">电机转速</Label>
              <Button FrameworkElement.Width="20" Grid.Column="1" Click="MotorSub">-<!--Unknown connection ID: 34--></Button>
              <Slider RangeBase.Minimum="100" RangeBase.Maximum="4900" FrameworkElement.Margin="4,0,0,4" Grid.Column="2">
                <RangeBase.Value>
                  <Binding Path="Motor"/>
                </RangeBase.Value>
              </Slider>
              <Button FrameworkElement.Width="20" Grid.Column="3" Click="MotorAdd">+<!--Unknown connection ID: 35--></Button>
            </Grid>
            <StackPanel Orientation="Horizontal">
              <Label>电机转速设定值：</Label>
              <Label>
                <ContentControl.Content>
                  <Binding Path="Motor"/>
                </ContentControl.Content>
              </Label>
            </StackPanel>
          </StackPanel>
        </TabItem>
      </TabControl>
      <Button Grid.Row="2" FrameworkElement.Margin="0,10,10,0" FrameworkElement.Height="30" Click="SaveClick">
        <UIElement.IsEnabled>
          <Binding Path="SaveButIsDisable"/>
        </UIElement.IsEnabled>
        <ContentControl.Content>
          <Binding Path="SaveButContent"/>
        </ContentControl.Content>
        <!--Unknown connection ID: 36-->
      </Button>
    </Grid>
  </Grid>
</Window>