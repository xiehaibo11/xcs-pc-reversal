<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="distinguish.OnlineWindows" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:distinguish" Window.WindowStartupLocation="CenterScreen" Window.Title="联机配置" FrameworkElement.Height="340" FrameworkElement.Width="450" Window.ResizeMode="NoResize">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:RadioToBoolConverter x:Key="genderConverterKey" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <StackPanel FrameworkElement.Margin="4,4,4,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">东方：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ConfigNumber.East</Ctor>
              </Binding>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">南方：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ConfigNumber.South</Ctor>
              </Binding>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">西方：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ConfigNumber.West</Ctor>
              </Binding>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">北方：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ConfigNumber.North</Ctor>
              </Binding>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="4">
          <Button FrameworkElement.Margin="10,0,0,0">
            <ContentControl.Content>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SaveConfigNumberButContent</Ctor>
              </Binding>
            </ContentControl.Content>
            <UIElement.IsEnabled>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SaveConfigNumberButIsDisable</Ctor>
              </Binding>
            </UIElement.IsEnabled>
            <!--Unknown connection ID: 1-->
          </Button>
        </Grid>
      </Grid>
      <Border FrameworkElement.Margin="0,10,0,0" FrameworkElement.Height="0.5" Background="#FF000000" />
      <Grid FrameworkElement.Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0">数据发送：</Label>
        <StackPanel Grid.Column="1" Orientation="Horizontal" FrameworkElement.Margin="0,6,0,0">
          <RadioButton>
            <ToggleButton.IsChecked>
              <Binding Converter="{StaticResource genderConverterKey}" ConverterParameter="1">
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DataConfig.Data_send</Ctor>
              </Binding>
            </ToggleButton.IsChecked>自动发送</RadioButton>
          <RadioButton FrameworkElement.Margin="4,0,0,0">
            <ToggleButton.IsChecked>
              <Binding Converter="{StaticResource genderConverterKey}" ConverterParameter="0">
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DataConfig.Data_send</Ctor>
              </Binding>
            </ToggleButton.IsChecked>手动发送</RadioButton>
        </StackPanel>
      </Grid>
      <Grid FrameworkElement.Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0">计数方式：</Label>
        <StackPanel Grid.Column="1" Orientation="Horizontal" FrameworkElement.Margin="0,6,0,0">
          <RadioButton>
            <ToggleButton.IsChecked>
              <Binding Converter="{StaticResource genderConverterKey}" ConverterParameter="1">
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DataConfig.Count_type</Ctor>
              </Binding>
            </ToggleButton.IsChecked>光控计数</RadioButton>
          <RadioButton FrameworkElement.Margin="4,0,0,0">
            <ToggleButton.IsChecked>
              <Binding Converter="{StaticResource genderConverterKey}" ConverterParameter="0">
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DataConfig.Count_type</Ctor>
              </Binding>
            </ToggleButton.IsChecked>机头计数</RadioButton>
        </StackPanel>
      </Grid>
      <Grid FrameworkElement.Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">超时发送时间：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DataConfig.Timeout</Ctor>
              </Binding>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">延时发送时间：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DataConfig.Delay</Ctor>
              </Binding>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="2">
          <Button FrameworkElement.Margin="10,0,0,0">
            <ContentControl.Content>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SaveDataConfigButContent</Ctor>
              </Binding>
            </ContentControl.Content>
            <UIElement.IsEnabled>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SaveDataConfigButIsDisable</Ctor>
              </Binding>
            </UIElement.IsEnabled>
            <!--Unknown connection ID: 2-->
          </Button>
        </Grid>
      </Grid>
      <Border FrameworkElement.Margin="0,10,0,0" FrameworkElement.Height="0.5" Background="#FF000000" />
      <StackPanel Orientation="Horizontal" FrameworkElement.Margin="0,10,0,0">
        <Label ContentControl.Content="当前WIFI配置：" />
        <Label ContentControl.Content="《" />
        <Label>
          <ContentControl.Content>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WifiConfig.Ssid</Ctor>
            </Binding>
          </ContentControl.Content>
        </Label>
        <Label ContentControl.Content="》" />
        <Label ContentControl.Content="密码：" />
        <Label ContentControl.Content="《" />
        <Label>
          <ContentControl.Content>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WifiConfig.Pwd</Ctor>
            </Binding>
          </ContentControl.Content>
        </Label>
        <Label ContentControl.Content="》" />
      </StackPanel>
      <Grid FrameworkElement.Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">WIFI：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WifiConfig.Ssid</Ctor>
              </Binding>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0">密码：</Label>
          <TextBox Grid.Column="1" Control.VerticalContentAlignment="Center">
            <TextBox.Text>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WifiConfig.Pwd</Ctor>
              </Binding>
            </TextBox.Text>
          </TextBox>
        </Grid>
        <Grid Column="2">
          <Button FrameworkElement.Margin="10,0,0,0">
            <ContentControl.Content>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SaveWifiConfigButContent</Ctor>
              </Binding>
            </ContentControl.Content>
            <UIElement.IsEnabled>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SaveWifiConfigButIsDisable</Ctor>
              </Binding>
            </UIElement.IsEnabled>
            <!--Unknown connection ID: 3-->
          </Button>
        </Grid>
      </Grid>
      <Border FrameworkElement.Margin="0,10,0,0" FrameworkElement.Height="0.5" Background="#FF000000" />
      <WrapPanel FrameworkElement.Margin="0,20,0,0">
        <Button Control.Padding="10,10,10,10">重启所有设备<!--Unknown connection ID: 4--></Button>
        <Button FrameworkElement.Margin="15,0,0,0" Control.Padding="10,10,10,10">重置专属密码<!--Unknown connection ID: 5--></Button>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>