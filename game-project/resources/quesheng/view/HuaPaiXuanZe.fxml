<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/8.0.112" xmlns:fx="http://javafx.com/fxml/1" fx:controller="quesheng.dialog.HuaPaiXuanZeDialog">
   <children>
      <VBox>
         <children>
            <HBox>
               <children>
                  <VBox>
                     <children>
                        <HBox fx:id="huapai_h_1" />
                        <HBox fx:id="huapai_h_2" />
                        <HBox fx:id="huapai_h_3" />
                     </children>
                  </VBox>
                  <AnchorPane prefHeight="118.0" prefWidth="155.0">
                     <children>
                        <Button fx:id="huapai_ok_btn" layoutX="44.0" layoutY="14.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="68.0" text="确定" />
                        <Button fx:id="huapai_cancle_btn" layoutX="44.0" layoutY="63.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="68.0" text="取消" />
                        <CheckBox fx:id="huapai_meijuchongshe" layoutX="44.0" layoutY="107.0" mnemonicParsing="false" text="每局重设" />
                     </children>
                  </AnchorPane>
               </children>
            </HBox>
            <VBox>
               <children>
                  <HBox fx:id="huapai_h_4" />
                  <HBox fx:id="huapai_h_5" />
                  <HBox fx:id="huapai_label" alignment="CENTER" prefHeight="26.0">
                     <children>
                        <Label text="注:选中每局重设，每局开始都会提示设置" />
                     </children></HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
   <stylesheets>
      <URL value="@Main.css" />
   </stylesheets>
</AnchorPane>
